# ── GitHub App (needed to build invoice-api — private invoice-models dep) ─
# App ID and installation ID: Settings → Developer settings → GitHub Apps
# Private key: downloaded as a .pem from the same page
GITHUB_APP_ID=<numeric-app-id>
GITHUB_APP_PRIVATE_KEY=/path/to/private-key.pem
GITHUB_APP_INSTALL_ID=<numeric-installation-id>
# Generated at build time — do not put a static value here:
#   export GITHUB_TOKEN=$(uv run scripts/github_app_token.py)
#   docker compose up -d --build

# ── Supabase (run `supabase start` to get these values) ───────────────────
# Copy from `supabase status` output after starting local Supabase.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=invoices

# ── load test (scripts/load_test.py) ─────────────────────────────────────
# SUPABASE_ANON_KEY: copy from `supabase status` → Publishable key (formerly "anon key")
SUPABASE_ANON_KEY=<anon-key>
TEST_EMAIL=test@example.com
TEST_PASSWORD=<test-user-password>
TOTAL_FILES=50

# ── invoice-api ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── invoice-pipeline (worker-img only) ────────────────────────────────────
GEMINI_API_KEY=
GEMINI_RATE_LIMIT_RPM=60
